# All values below are optional. With nothing set, the backend serves the
# bundled sample catalog so judges can demo without provisioning a store.

# Shopify Admin API credentials — leave blank to use sample data
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-04

# Force the sample catalog even when Shopify credentials are configured
USE_SAMPLE_DATA=true

# HTTP port
PORT=5000
